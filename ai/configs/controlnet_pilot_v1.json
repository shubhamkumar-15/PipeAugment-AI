    "num_inference_steps": 30,
    "guidance_scale": 5.0,
    "strengths": [0.35],
    "conditions": [
      "low_light_inspection",
      "directional_industrial_lighting"
    ]
  },
  "storage": {
    "output_dir": "experiments/pilots/controlnet_canny_v1",
    "reference_diffusion_dir": "experiments/pilots/diffusion_v1"
