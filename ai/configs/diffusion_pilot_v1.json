{
  "pilot_name": "diffusion_pilot_v1",
  "model": {
    "model_id": "stable-diffusion-v1-5/stable-diffusion-v1-5",
    "model_revision": "main",
    "torch_dtype": "float16",
    "variant": "fp16",
    "use_safetensors": true,
    "device": "cuda",
    "offload_strategy": "none"
  },
  "dataset": {
    "train_manifest": "datasets/manifests/train.csv",
    "raw_root": "datasets/raw/k-pipelines",
    "selection_seed": 42,
    "num_parents_per_class": 3,
    "target_size": [512, 512]
  },
  "generation": {
    "num_inference_steps": 30,
    "guidance_scale": 5.0,
    "strengths": [0.20, 0.35],
    "conditions": [
      "low_light_inspection",
      "directional_industrial_lighting"
    ]
  },
  "storage": {
    "output_dir": "experiments/pilots/diffusion_v1"
  }
}
